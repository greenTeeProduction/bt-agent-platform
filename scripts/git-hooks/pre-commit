#!/bin/bash
# Pre-commit hook for go-bt-evolve
# Runs: gofmt check → go vet → golangci-lint (staged pkgs) → go mod tidy
#       → doc drift → ci-doctor → go test -short
# Mirrors the CI Lint job (.github/workflows/ci.yml) so commits don't pass
# locally and fail the pipeline. Full-repo parity run: make check-quick.
# Fails fast — blocks commit if any check fails.
# Install: make pre-commit-install

set -euo pipefail

GO="/usr/local/go/bin/go"
GOFMT="/usr/local/go/bin/gofmt"

# Detect if go is at standard location
if ! command -v "$GO" &>/dev/null; then
    GO="go"
    GOFMT="gofmt"
fi

echo "🔍 pre-commit: go-bt-evolve checks..."
echo ""

# 1. gofmt on staged Go files only
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)
if [ -n "$STAGED_GO_FILES" ]; then
    echo "→ gofmt check on staged files..."
    UNFORMATTED=$($GOFMT -l $STAGED_GO_FILES 2>/dev/null || true)
    if [ -n "$UNFORMATTED" ]; then
        echo "✗ The following staged files need formatting:"
        echo "$UNFORMATTED"
        echo ""
        echo "  Run: make fmt"
        echo "  Then: git add <files>"
        exit 1
    fi
    echo "  ✓ formatted"
fi

# 2. go vet on the full project
echo "→ go vet..."
if ! $GO vet ./... 2>&1; then
    echo "✗ go vet found issues. Fix before committing."
    exit 1
fi
echo "  ✓ passed"

# 3. golangci-lint on packages with staged Go changes (CI Lint job parity —
#    same binary version and .golangci.yml as the pipeline; full repo: make lint)
GOLANGCI="$($GO env GOPATH)/bin/golangci-lint"
if ! command -v "$GOLANGCI" &>/dev/null; then
    GOLANGCI="golangci-lint"
fi
if [ -n "$STAGED_GO_FILES" ]; then
    if command -v "$GOLANGCI" &>/dev/null; then
        STAGED_PKG_DIRS=$(echo "$STAGED_GO_FILES" | xargs -n1 dirname | sort -u | sed 's|^|./|')
        echo "→ golangci-lint (staged packages)..."
        if ! "$GOLANGCI" run --timeout=5m $STAGED_PKG_DIRS 2>&1; then
            echo "✗ golangci-lint found issues — the CI Lint job runs the same linters repo-wide."
            echo "  Full parity run: make check-quick"
            exit 1
        fi
        echo "  ✓ passed"
    else
        echo "  ⚠ golangci-lint not installed (make tools-install) — CI will still run it"
    fi
fi

# 4. go mod tidy sync check (CI Lint job parity)
echo "→ go mod tidy check..."
$GO mod tidy
if ! git diff --exit-code go.mod go.sum >/dev/null 2>&1; then
    echo "✗ go.mod/go.sum out of sync — go mod tidy changed them; stage and retry."
    exit 1
fi
echo "  ✓ passed"

# 5. Doc drift check if docs/ files are staged
STAGED_DOCS=$(git diff --cached --name-only --diff-filter=ACM | grep '^docs/' || true)
if [ -n "$STAGED_DOCS" ]; then
    echo "→ documentation drift check (docs/ changed)..."
    SCRIPT_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
    if ! "$SCRIPT_DIR/scripts/check-doc-drift.sh" 2>&1; then
        echo "✗ Documentation drift detected. Update docs to match codebase."
        exit 1
    fi
    echo "  ✓ docs in sync"
fi

# 6. CI Doctor — validate workflow maturity (always runs, blocks commit on failure)
REPO_ROOT=$(git rev-parse --show-toplevel)
echo "→ ci-doctor workflow maturity check..."
if [ -f "$REPO_ROOT/bin/bt-ci-doctor" ]; then
    CI_DOCTOR_OUTPUT=$("$REPO_ROOT/bin/bt-ci-doctor" --root "$REPO_ROOT" 2>&1)
    CI_DOCTOR_EXIT=$?
    if [ $CI_DOCTOR_EXIT -ne 0 ]; then
        echo "✗ CI/CD workflow maturity check failed."
        echo "$CI_DOCTOR_OUTPUT" | grep '^✗'
        exit 1
    fi
    SUMMARY=$(echo "$CI_DOCTOR_OUTPUT" | head -1)
    echo "  ✓ $SUMMARY"
else
    echo "  ⚠ bt-ci-doctor not built — run 'make ci-doctor' first"
    echo "  → Attempting to build ci-doctor..."
    if "$GO" build -o "$REPO_ROOT/bin/bt-ci-doctor" ./cmd/bt-ci-doctor/ 2>/dev/null; then
        echo "  ✓ bt-ci-doctor built"
        CI_DOCTOR_OUTPUT=$("$REPO_ROOT/bin/bt-ci-doctor" --root "$REPO_ROOT" 2>&1)
        CI_DOCTOR_EXIT=$?
        if [ $CI_DOCTOR_EXIT -ne 0 ]; then
            echo "✗ CI/CD workflow maturity check failed."
            echo "$CI_DOCTOR_OUTPUT" | grep '^✗'
            exit 1
        fi
        SUMMARY=$(echo "$CI_DOCTOR_OUTPUT" | head -1)
        echo "  ✓ $SUMMARY"
    else
        echo "  ⚠ Could not build ci-doctor — skip with --no-verify if needed"
    fi
fi

# 7. Fast tests (no race — CI runs full -race; gardener skipped — known timeout)
echo "→ go test -short..."
if ! $GO test -short -count=1 -timeout 120s $($GO list ./... | grep -v gardener) 2>&1; then
    echo "✗ Tests failed. Fix before committing."
    exit 1
fi
echo "  ✓ passed"

echo ""
echo "✅ pre-commit checks passed"
